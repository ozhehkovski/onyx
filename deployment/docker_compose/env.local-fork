# Environment for docker-compose.local-fork.yml (local evaluation only).
IMAGE_TAG=local
HOST_PORT=3030
# Port 80 is often taken on dev machines; nginx also listens here.
HOST_PORT_80=8088
KEYCLOAK_HOST_PORT=8180
KEYCLOAK_OIDC_CLIENT_SECRET=onyx-local-oidc-secret
# Query history mode: normal | anonymized | disabled
ONYX_QUERY_HISTORY_TYPE=normal
# UI language for new users and the login page (en, pl, de, ...)
DEFAULT_LANGUAGE=pl
